// =====================================================================
// College Event Management System (SEPM Mini-Project)
// Prisma schema -- consistent with SEPM_Database_Schema.sql
// Written for Prisma 6.x with PostgreSQL.
// (In Prisma 7 the datasource url moves to prisma.config.ts.)
//
// Field names intentionally match the ER diagram / SQL column names
// (snake_case) so the design, database and code use identical names.
//
// Not expressible in Prisma (kept in the SQL script / a custom migration):
//   - CHECK constraints (capacity > 0, end_time > start_time,
//     max_participants > 0, email lower-case)
//   - the events.updated_at database trigger
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ENUMS (native PostgreSQL enum types)
// ---------------------------------------------------------------------

enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN

  @@map("user_role")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED

  @@map("event_status")
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED

  @@map("registration_status")
}

// ---------------------------------------------------------------------
// TABLE 1: USERS
// ---------------------------------------------------------------------

model User {
  id                Int      @id(map: "pk_users") @default(autoincrement())
  name              String   @db.VarChar(100)
  email             String   @unique(map: "uq_users_email") @db.VarChar(255)
  student_id_number String   @unique(map: "uq_users_student_id_number") @db.VarChar(30)
  password_hash     String   @db.VarChar(255)
  role              UserRole @default(STUDENT)
  department        String?  @db.VarChar(100)
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  // USERS 1 --- 0..N EVENTS         (organizes)
  organized_events    Event[]        @relation("EventOrganizer")
  // USERS 1 --- 0..N REGISTRATIONS  (makes)
  registrations       Registration[] @relation("StudentRegistrations")
  // USERS 1 --- 0..N CERTIFICATES   (issues)
  issued_certificates Certificate[]  @relation("CertificateIssuer")

  @@map("users")
}

// ---------------------------------------------------------------------
// TABLE 2: VENUES
// ---------------------------------------------------------------------

model Venue {
  id       Int    @id(map: "pk_venues") @default(autoincrement())
  name     String @unique(map: "uq_venues_name") @db.VarChar(100)
  location String @db.VarChar(255)
  capacity Int

  // VENUES 1 --- 0..N EVENTS (hosts)
  events Event[] @relation("VenueEvents")

  @@map("venues")
}

// ---------------------------------------------------------------------
// TABLE 3: EVENTS
// ---------------------------------------------------------------------

model Event {
  id                    Int         @id(map: "pk_events") @default(autoincrement())
  title                 String      @db.VarChar(200)
  description           String
  organizer_id          Int
  venue_id              Int
  start_time            DateTime    @db.Timestamptz(6)
  end_time              DateTime    @db.Timestamptz(6)
  registration_deadline DateTime    @db.Timestamptz(6)
  max_participants      Int?
  status                EventStatus @default(DRAFT)
  cancel_reason         String?
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  organizer User  @relation("EventOrganizer", fields: [organizer_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_events_organizer")
  venue     Venue @relation("VenueEvents", fields: [venue_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_events_venue")

  // EVENTS 1 --- 0..N REGISTRATIONS (receives)
  registrations Registration[] @relation("EventRegistrations")

  @@index([organizer_id], map: "idx_events_organizer_id")
  @@index([venue_id, start_time], map: "idx_events_venue_id_start_time")
  @@index([status, start_time], map: "idx_events_status_start_time")
  @@map("events")
}

// ---------------------------------------------------------------------
// TABLE 4: REGISTRATIONS
// ---------------------------------------------------------------------

model Registration {
  id                   Int                @id(map: "pk_registrations") @default(autoincrement())
  event_id             Int
  student_id           Int
  status               RegistrationStatus @default(REGISTERED)
  certificate_eligible Boolean            @default(false)
  registered_at        DateTime           @default(now()) @db.Timestamptz(6)

  event   Event @relation("EventRegistrations", fields: [event_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_registrations_event")
  student User  @relation("StudentRegistrations", fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_registrations_student")

  // REGISTRATIONS 1 --- 0..1 CERTIFICATES (earns)
  certificate Certificate?

  // A student can register only once for the same event
  @@unique([event_id, student_id], map: "uq_registrations_event_student")
  @@index([student_id], map: "idx_registrations_student_id")
  @@map("registrations")
}

// ---------------------------------------------------------------------
// TABLE 5: CERTIFICATES
// ---------------------------------------------------------------------

model Certificate {
  id              Int      @id(map: "pk_certificates") @default(autoincrement())
  registration_id Int      @unique(map: "uq_certificates_registration_id")
  certificate_no  String   @unique(map: "uq_certificates_certificate_no") @db.VarChar(50)
  file_path       String   @db.VarChar(500)
  issued_at       DateTime @default(now()) @db.Timestamptz(6)
  issued_by       Int

  registration Registration @relation(fields: [registration_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_certificates_registration")
  issuer       User         @relation("CertificateIssuer", fields: [issued_by], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_certificates_issuer")

  @@map("certificates")
}
