# College Event Management System Frontend Configuration
# Base URL for backend REST API (Layered Monolithic Architecture on Node.js/Express)
VITE_API_BASE_URL=http://localhost:3000/api

# Set to 'true' to use the comprehensive local mock service for development and testing
# Set to 'false' to connect directly to the real Express backend at VITE_API_BASE_URL
VITE_USE_MOCK=true

# College Branding Placeholders (fully editable)
VITE_COLLEGE_NAME=Apex Institute of Technology
VITE_COLLEGE_SHORT_NAME=AIT
VITE_SUPPORT_EMAIL=events-support@apex.edu
